                "value": ""
              },
              {
                "name": "x-realm-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "Mosaic Team ID issued by your CSM."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a time entry."
        },
        {
          "info": {
            "name": "Updates a time entry.",
            "type": "http"
          },
