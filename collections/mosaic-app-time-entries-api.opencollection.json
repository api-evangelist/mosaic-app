                "name": "x-origin",
                "value": ""
              },
              {
                "name": "x-tenant",
                "value": ""
              },
              {
                "name": "x-realm-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path",
                "description": "Mosaic Team ID issued by your CSM."
              }
            ]
          },
          "docs": "Fetches all time entries."
        },
        {
          "info": {
