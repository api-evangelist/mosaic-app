{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mosaic Open Members Time Entries API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Time Entries",
